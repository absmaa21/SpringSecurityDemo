### Test 1: SignIn with invalid credentials
POST http://localhost:8080/api/auth/signin
Content-Type: application/json

{
  "username": "wrong@example.com",
  "password": "wrongpassword"
}

### Test 2: SignIn with correct credentials but invalid password
POST http://localhost:8080/api/auth/signin
Content-Type: application/json

{
  "username": "test@example.com",
  "password": "wrongpassword"
}

### Test 3: Try to access OTP endpoint without MFA token
GET http://localhost:8080/api/auth/otp-signin?otp=123456

### Test 4: Try to access OTP endpoint with regular JWT instead of MFA token
# First get a regular JWT from /api/auth/login
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "test@example.com",
  "password": "testpassword123"
}

> {%
client.global.set("regularJwt", response.body.token);
%}

### Test 5: Try OTP verification with regular JWT (should fail)
GET http://localhost:8080/api/auth/otp-signin?otp=123456
Authorization: Bearer {{regularJwt}}

### Test 6: Try OTP verification with wrong OTP
# First get MFA token
POST http://localhost:8080/api/auth/signin
Content-Type: application/json

{
  "username": "test@example.com",
  "password": "testpassword123"
}

> {%
client.global.set("mfaToken", response.body.token);
%}

### Test 7: Submit wrong OTP
GET http://localhost:8080/api/auth/otp-signin?otp=000000
Authorization: Bearer {{mfaToken}}

### Test 8: Try to access private endpoint with MFA token (should fail)
GET http://localhost:8080/api/private/user
Authorization: Bearer {{mfaToken}}

### Test 9: Try to access private endpoint without any token
GET http://localhost:8080/api/private/user

### Test 10: Try to use expired OTP (wait 5+ minutes after signin)
# First get MFA token
POST http://localhost:8080/api/auth/signin
Content-Type: application/json

{
  "username": "test@example.com",
  "password": "testpassword123"
}

> {%
client.global.set("mfaToken", response.body.token);
%}

### Test 11: Wait 5+ minutes and try to verify OTP (should fail)
# Wait at least 5 minutes before running this request
GET http://localhost:8080/api/auth/otp-signin?otp=123456
Authorization: Bearer {{mfaToken}}
